{
  "mcpServers": {
    "kgbcia-mcp": {
      "command": "uv",
      "args": ["run", "kgbcia-mcp", "serve", "--enable-cypher"],
      "env": {
         "NEO4J_URI": "bolt://<neo4j_server_ip>:7687",
         "NEO4J_DATABASE": "neo4j",
         "KGB_MCP_ARTIFACTS": "<zipped transformation data accessible URL from public s3>",
         "KGB_MCP_ARTIFACTS_SHA256": "<zipped transformation data SHA256 checksum hash>"
      }
    }
  }
}
